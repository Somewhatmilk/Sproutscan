# Copy to .env and fill in real values. Never commit .env.
# SECRET_KEY must stay EMPTY here: a known public value copied verbatim into .env
# would run with a forgeable key and bypass the fail-loud start gate (app.py:25).
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE=plantations.db

# Google OAuth (optional — only needed for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MFA / TOTP
MFA_SECRET=